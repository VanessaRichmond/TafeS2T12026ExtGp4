<Page x:Class="Calculator.CurrencyConverter"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
	  Background="{ThemeResource SystemControlAcrylicWindowBrush}">

	<Grid Background="#D0D3D4" Padding="40">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Title -->
		<TextBlock Grid.Row="0"
                   Text="Currency Conversion Calculator"
                   FontSize="36"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>

		<!-- Labels and Inputs -->
		<Grid Grid.Row="1" Margin="0,0,0,20">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*"/>
				<ColumnDefinition Width="2*"/>
				<ColumnDefinition Width="2*"/>
			</Grid.ColumnDefinitions>

			<!-- Amount -->
			<StackPanel Grid.Column="0">
				<TextBlock Text="Amount:" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
				<TextBox x:Name="AmountTextBox" Width="200" Height="35" PlaceholderText="Enter amount"/>
			</StackPanel>

			<!-- From -->
			<StackPanel Grid.Column="1">
				<TextBlock Text="From:" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
				<ComboBox x:Name="FromCurrencyComboBox" Width="240" Height="35" SelectedIndex="0">
					<ComboBoxItem Tag="USD">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="USD - US Dollar" VerticalAlignment="Center"/>
							<Image Source="Images/USA1.PNG" Width="30" Height="20" Margin="20,0,0,0"/>
						</StackPanel>
					</ComboBoxItem>
					<ComboBoxItem Tag="EUR">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="EUR - Euro" VerticalAlignment="Center"/>
							<Image Source="Images/EUR1.PNG" Width="30" Height="20" Margin="20,0,0,0"/>
						</StackPanel>
					</ComboBoxItem>
					<ComboBoxItem Tag="GBP">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="GBP - British Pound" VerticalAlignment="Center"/>
							<Image Source="Images/UK1.PNG" Width="30" Height="20" Margin="20,0,0,0"/>
						</StackPanel>
					</ComboBoxItem>
					<ComboBoxItem Tag="INR">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="INR - Indian Rupee" VerticalAlignment="Center"/>
							<Image Source="Images/INDIA.PNG" Width="30" Height="20" Margin="20,0,0,0"/>
						</StackPanel>
					</ComboBoxItem>
				</ComboBox>
			</StackPanel>

			<!-- To -->
			<StackPanel Grid.Column="2">
				<TextBlock Text="To:" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
				<ComboBox x:Name="ToCurrencyComboBox" Width="240" Height="35" SelectedIndex="0">
					<ComboBoxItem Tag="USD">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="USD - US Dollar" VerticalAlignment="Center"/>
							<Image Source="Images/USA1.PNG" Width="30" Height="20" Margin="20,0,0,0"/>
						</StackPanel>
					</ComboBoxItem>
					<ComboBoxItem Tag="EUR">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="EUR - Euro" VerticalAlignment="Center"/>
							<Image Source="Images/EUR1.PNG" Width="30" Height="20" Margin="20,0,0,0"/>
						</StackPanel>
					</ComboBoxItem>
					<ComboBoxItem Tag="GBP">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="GBP - British Pound" VerticalAlignment="Center"/>
							<Image Source="Images/UK1.PNG" Width="30" Height="20" Margin="20,0,0,0"/>
						</StackPanel>
					</ComboBoxItem>
					<ComboBoxItem Tag="INR">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="INR - Indian Rupee" VerticalAlignment="Center"/>
							<Image Source="Images/INDIA.PNG" Width="30" Height="20" Margin="20,0,0,0"/>
						</StackPanel>
					</ComboBoxItem>
				</ComboBox>
			</StackPanel>
		</Grid>

		<!-- Conversion Result -->
		<StackPanel Grid.Row="2" Margin="0,20,0,0">
			<TextBlock x:Name="ConversionResultText" FontSize="20" Margin="0,0,0,10"/>
			<TextBlock x:Name="ConvertedAmountText" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
		</StackPanel>

		<!-- Exchange Rates -->
		<StackPanel Grid.Row="3" Margin="0,10,0,0">
			<TextBlock x:Name="Rate1Text" FontSize="18" Margin="0,5,0,0"/>
			<TextBlock x:Name="Rate2Text" FontSize="18" Margin="0,5,0,0"/>
		</StackPanel>

		<!-- Buttons -->
		<StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,30,0,0">
			<Button Content="Calculate Currency"
                    Width="200" Height="45"
                    Background="#A6A6A6"
                    Foreground="Black"
                    FontSize="18"
                    Margin="0,5"
					Click="CalculateCurrency_Click"/>
			
			<Button Content="Exit to Main Menu"
                    Width="200" Height="45"
                    Background="#A6A6A6"
                    Foreground="Black"
                    FontSize="18"
                    Margin="0,5"
					Click="Exit_Click"/>
		</StackPanel>
	</Grid>
</Page>
