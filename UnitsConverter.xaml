<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Calculator.UnitsConverter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="350"
    Height="550"
    Background="{ThemeResource SystemControlAcrylicWindowBrush}">

	<Grid Background="#F0F0F0" Margin="20">

		<Grid.RowDefinitions>
			<RowDefinition Height="70"/>
			<RowDefinition Height="55"/>
			<RowDefinition Height="55"/>
			<RowDefinition Height="55"/>
			<RowDefinition Height="55"/>
			<RowDefinition Height="55"/>
			<RowDefinition Height="80"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Title -->
		<TextBlock
            Grid.Row="0"
            Text="Units Converter"
            FontSize="28"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

		<!-- Conversion Type -->
		<ComboBox
            Grid.Row="1"
            x:Name="ConversionTypeComboBox"
            Header="Conversion Type"
            SelectionChanged="ConversionTypeComboBox_SelectionChanged"
            Width="250"
            HorizontalAlignment="Center">

			<ComboBoxItem Content="Temperature"/>
			<ComboBoxItem Content="Distance"/>
			<ComboBoxItem Content="Mass"/>
			<ComboBoxItem Content="Pressure"/>

		</ComboBox>

		<!-- From Unit -->
		<ComboBox
            Grid.Row="2"
            x:Name="FromUnitComboBox"
            Header="From"
            Width="250"
            HorizontalAlignment="Center"/>

		<!-- To Unit -->
		<ComboBox
            Grid.Row="3"
            x:Name="ToUnitComboBox"
            Header="To"
            Width="250"
            HorizontalAlignment="Center"/>

		<!-- Input -->
		<TextBox
            Grid.Row="4"
            x:Name="InputValueTextBox"
            Header="Enter Value"
            PlaceholderText="Enter value"
            Width="250"
            HorizontalAlignment="Center"/>

		<!-- Convert Button -->
		<Button
            Grid.Row="5"
            Content="Convert"
            Click="ConvertButton_Click"
            FontSize="18"
            Height="45"
            Width="150"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

		<!-- Result -->
		<StackPanel
            Grid.Row="6"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

			<TextBlock
                Text="Result"
                FontSize="18"
                HorizontalAlignment="Center"/>

			<TextBlock
                x:Name="ResultTextBlock"
                Text="0"
                FontSize="24"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,5,0,0"/>

		</StackPanel>

		<!-- Instructions -->
		<TextBlock
            Grid.Row="7"
            Text="Select a conversion type, choose the units, enter a value and press Convert."
            TextWrapping="Wrap"
            FontSize="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            TextAlignment="Center"
            Margin="15,10,15,0"/>

	</Grid>

</Page>