<Page x:Class="Calculator.MainMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Height="550" Width="350"
	  Background="{ThemeResource SystemControlAcrylicWindowBrush}">

	<Grid Background="#F0F0F0" Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="150"/>
			<RowDefinition Height="60"/>
			<RowDefinition Height="60"/>
			<RowDefinition Height="60"/>
			<RowDefinition Height="60"/>
			<RowDefinition Height="60"/>
			<RowDefinition Height="60"/>
			<RowDefinition/>
		</Grid.RowDefinitions>

		<!-- Logo -->
		<Image Grid.Row="0"
			   Width="200" Height="150"
			   Source="Images/abacus.jpg" />

		<!-- Title -->
		<TextBlock Grid.Row="1"
				   Text="Universal Calculator"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,10" Width="270"/>

		<!-- Buttons -->
		<Button Grid.Row="2" Content="Maths Calculator" Click="MathCalculator_Click"
                FontSize="18" Height="45" Width="185" HorizontalAlignment="Center"/>


<Button Grid.Row="3" Content="Mortgage Calculator" Click="MortgageCalculator_Click"
    FontSize="18" Height="45" Width="185" HorizontalAlignment="Center"/>
		<Button Grid.Row="4" Content="Currency Converter" Click="CurrencyConverter_Click"
                FontSize="18" Height="45" Width="185" HorizontalAlignment="Center"/>


		<Button Grid.Row="5" Content="Units Converter" Click="UnitsConverter_Click" 
				FontSize="18" Height="45" Width="185" HorizontalAlignment="Center"/>


		<Button Grid.Row="6" Content="Exit" Click="Exit_Click"
                FontSize="18" Height="45" Width="185" HorizontalAlignment="Center"/>
	</Grid>
</Page>
